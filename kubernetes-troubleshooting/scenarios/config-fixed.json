{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "trouble-missing-env",
        "namespace": "devops-advanced"
      },
      "data": {
        "MODE": "repaired"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "namespace": "devops-advanced",
        "name": "trouble-config"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "demo",
            "image": "busybox:1.36.1",
            "command": [
              "sh",
              "-c",
              "echo healthy; sleep 3600"
            ],
            "resources": {
              "requests": {
                "cpu": "5m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "50m",
                "memory": "32Mi"
              }
            },
            "env": [
              {
                "name": "MODE",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "trouble-missing-env",
                    "key": "MODE"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
