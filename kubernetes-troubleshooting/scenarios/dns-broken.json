{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "namespace": "devops-advanced",
    "name": "trouble-dns"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "demo",
        "image": "busybox:1.36.1",
        "command": [
          "sh",
          "-c",
          "echo healthy; sleep 3600"
        ],
        "resources": {
          "requests": {
            "cpu": "5m",
            "memory": "8Mi"
          },
          "limits": {
            "cpu": "50m",
            "memory": "32Mi"
          }
        }
      }
    ],
    "dnsPolicy": "None",
    "dnsConfig": {
      "nameservers": [
        "192.0.2.1"
      ],
      "options": [
        {
          "name": "timeout",
          "value": "1"
        },
        {
          "name": "attempts",
          "value": "1"
        }
      ]
    }
  }
}
