{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "namespace": "devops-advanced",
    "name": "trouble-network"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "demo",
        "image": "python:3.12-alpine",
        "command": [
          "python",
          "-m",
          "http.server",
          "8080",
          "--bind",
          "127.0.0.1"
        ],
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "startupProbe": {
          "exec": {
            "command": [
              "python",
              "-c",
              "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080', timeout=2).close()"
            ]
          },
          "periodSeconds": 2,
          "timeoutSeconds": 5,
          "failureThreshold": 30
        }
      }
    ]
  }
}
