{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "namespace": "devops-advanced",
    "name": "trouble-network"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "demo",
        "image": "python:3.12-alpine",
        "command": [
          "python",
          "-m",
          "http.server",
          "8080",
          "--bind",
          "127.0.0.1"
        ],
        "resources": {
          "requests": {
            "cpu": "5m",
            "memory": "8Mi"
          },
          "limits": {
            "cpu": "50m",
            "memory": "32Mi"
          }
        }
      }
    ]
  }
}
