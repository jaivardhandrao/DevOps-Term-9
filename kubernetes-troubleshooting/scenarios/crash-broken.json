{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "namespace": "devops-advanced",
    "name": "trouble-crash"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "demo",
        "image": "busybox:1.36.1",
        "command": [
          "sh",
          "-c",
          "echo intentional-startup-error >&2; exit 1"
        ],
        "resources": {
          "requests": {
            "cpu": "5m",
            "memory": "8Mi"
          },
          "limits": {
            "cpu": "50m",
            "memory": "32Mi"
          }
        }
      }
    ]
  }
}
