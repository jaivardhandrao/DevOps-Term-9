#!/bin/bash
set -euo pipefail
dnf install -y nginx
cat > /usr/share/nginx/html/index.html <<'HTML'
<!doctype html>
<html lang="en"><meta charset="utf-8"><title>Terraform coursework</title>
<h1>Hello from ${project_name}</h1>
<p>Jaivardhan D. Rao · 24BCS10117 · Session 19: Terraform cloud infrastructure</p>
<p>This page is served by Nginx on the Terraform-managed EC2 instance.</p></html>
HTML
systemctl enable --now nginx
